+def logical_source_bytes(p):
+    # 原PNV为预分配文件。只读取头部声明的有效行；容量尾部不是行情行。
+    with p.open('rb') as f:
+        header = f.read(64)
+        assert len(header) == 64
+        count = struct.unpack_from('<q', header, 16)[0]
+        assert count == 8964
+        payload = f.read(count * 8)
+        assert len(payload) == count * 8
+    return header + payload
 
 
