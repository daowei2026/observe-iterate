diff --git a/fixed_input.py b/fixed_input.py
new file mode 100644
index 0000000..9f9879a
--- /dev/null
+++ b/fixed_input.py
@@ -0,0 +1,307 @@
+"""只读固定 CSV 的显式窗口、原报价图及同源图层。
+
+本模块不调用 Feature、不推导业务指标或事件。业务调用方声明来源、窗口、
+行选择、字段绑定及可知时钟；原字段以字符串保留，数值/时间转换只供绘图。
+"""
+from __future__ import annotations
+
+import hashlib
+import io
+import json
+import re
+import zipfile
+from functools import lru_cache
+from html import escape
+from pathlib import Path
+from typing import Any
+
+import pandas as pd
+
+from .contracts import (
+    build_run_handle, ensure_chart_core_layout, register_runtime_run_brief,
+    safe_path_token, write_csv, write_json,
+)
+
+
+@lru_cache(maxsize=48)
+def _read_source_cached(encoded: str, mtime_ns: int, size: int) -> pd.DataFrame:
+    source = json.loads(encoded)
+    path = Path(source['path'])
+    if source.get('member'):
+        with zipfile.ZipFile(path) as archive:
+            payload = archive.read(source['member'])
+    else:
+        payload = path.read_bytes()
+    digest = hashlib.sha256(payload).hexdigest()
+    if digest != source['sha256']:
+        raise ValueError(f"固定成员身份改变: {source['id']}")
+    frame = pd.read_csv(io.BytesIO(payload), dtype=str, keep_default_na=False, encoding='utf-8-sig')
+    if any(str(c).startswith('_aidata_') for c in frame.columns):
+        raise ValueError('固定输入使用了保留的 _aidata_ 列名前缀')
+    frame['_aidata_source_row'] = range(2, len(frame) + 2)
+    frame['_aidata_source_id'] = source['id']
+    frame['_aidata_source_member'] = source.get('member', path.name)
+    frame['_aidata_source_sha256'] = digest
+    return frame
+
+
+def read_fixed_source(source: dict[str, Any]) -> pd.DataFrame:
+    """按确切成员 SHA 读取原件，物理行号包括表头；不修改原件。"""
+    path = Path(source['path'])
+    stat = path.stat()
+    return _read_source_cached(json.dumps(source, sort_keys=True), stat.st_mtime_ns, stat.st_size)
+
+
+def load_fixed_spec(run_or_dir) -> dict[str, Any]:
+    run_dir = Path(getattr(run_or_dir, 'run_dir', run_or_dir))
+    return json.loads((run_dir / 'manifest/fixed_input.json').read_text())
+
+
+def build_fixed_chart_run(brief: dict[str, Any]):
+    """接入声明的固定来源及人工窗口；绝不运行默认节点定位。"""
+    spec = brief['fixed_input']
+    if isinstance(spec, (str, Path)):
+        spec = json.loads(Path(spec).read_text())
+    if spec.get('schema_version') != 1:
+        raise ValueError('fixed_input.schema_version 必须是 1')
+    source_ids = [s['id'] for s in spec['sources']]
+    view_ids = [v['node_id'] for v in spec['views']]
+    if len(set(source_ids)) != len(source_ids) or len(set(view_ids)) != len(view_ids):
+        raise ValueError('source id / node_id 必须唯一')
+    for source in spec['sources']:
+        read_fixed_source(source)
+    for view in spec['views']:
+        if not view.get('asof') or pd.Timestamp(view['start']) > pd.Timestamp(view['end']):
+            raise ValueError(f"窗口/AsOf 无效: {view['node_id']}")
+        for layer in view['layers']:
+            if layer['source'] not in source_ids:
+                raise ValueError(f"未知固定来源: {layer['source']}")
+    run_id = brief['run_id']
+    if safe_path_token(run_id) != run_id:
+        raise ValueError('run_id 必须是单个路径安全标识')
+    run_dir = Path(brief['output_root']) / run_id
+    if (run_dir / 'manifest/fixed_input.json').exists():
+        raise FileExistsError(f'不覆盖已有固定 run: {run_id}')
+    ensure_chart_core_layout(run_dir)
+    run = build_run_handle(run_dir)
+    write_json(spec, run_dir / 'manifest/fixed_input.json')
+    resolved = {k: v for k, v in brief.items() if k != 'fixed_input'}
+    resolved.update(data_mode='fixed_input', fixed_input_manifest='manifest/fixed_input.json')
+    write_json(resolved, run.run_brief_path)
+    run.run_brief_md_path.write_text('# 固定输入图运行\n\n' + str(brief.get('run_note', '')) + '\n')
+    rows = [{
+        'node_id': v['node_id'], 'level': 'big', 'parent_node_id': '',
+        'start_uti': '', 'end_uti': '', 'start_ts': v['start'], 'end_ts': v['end'],
+        'label': v['label'], 'asof': v['asof'],
+        'member_symbols': json.dumps(v['symbols'], ensure_ascii=False),
+        'window_origin': 'explicit_fixed_input_request',
+    } for v in spec['views']]
+    write_csv(pd.DataFrame(rows), run.timespan_index_path)
+    write_csv(pd.DataFrame([{
+        **row, 'chart_family': 'fixed_input_raw_quote_v1',
+        'uses_explicit_timespan': True, 'reruns_extract_timespans': False,
+    } for row in rows]), run.chart_manifest_path)
+    write_json({'run_id': run_id, 'run_kind': 'chart_core', 'data_mode': 'fixed_input',
+                'view_count': len(rows), 'feature_executions': 0,
+                'completed_stages': ['chart_core'], 'source_count': len(source_ids)},
+               run_dir / 'manifest/run_summary.json')
+    register_runtime_run_brief(run_id, {**brief, 'fixed_input': spec})
+    return run
+
+
+def select_fixed_rows(spec: dict, view: dict, layer: dict, scope: str) -> pd.DataFrame:
+    """只应用调用方声明的谓词、显示窗口和可知时钟，保留原字符串值。"""
+    sources = {s['id']: s for s in spec['sources']}
+    frame = read_fixed_source(sources[layer['source']])
+    if layer.get('rows') is not None:
+        frame = frame[frame['_aidata_source_row'].isin(layer['rows'])]
+    for predicate in layer.get('filters', []):
+        values = frame[predicate['field']]
+        op, value = predicate.get('op', 'eq'), predicate['value']
+        if op == 'eq':
+            frame = frame[values == str(value)]
+        elif op == 'in':
+            frame = frame[values.isin([str(v) for v in value])]
+        elif op == 'not_empty':
+            frame = frame[values != '']
+        else:
+            raise ValueError(f'不支持的固定选择谓词: {op}')
+    # 时间字段必须显式配置；表格可保留整个被选原行，不隐式猜业务时间。
+    window_field = layer.get('window_field')
+    if window_field:
+        times = pd.to_datetime(frame[window_field], errors='coerce')
+        frame = frame[times.between(pd.Timestamp(view['start']), pd.Timestamp(view['end']))]
+    known_field = layer.get('known_at')
+    if scope == 'known' and known_field:
+        times = pd.to_datetime(frame[known_field], errors='coerce')
+        frame = frame[times <= pd.Timestamp(view['asof'])]
+    return frame.copy()
+
+
+def _bound(frame: pd.DataFrame, binding, sources: dict, *, time: bool = False):
+    if isinstance(binding, str):
+        values = frame[binding]
+    else:
+        values = frame[binding['field']]
+        lookup = binding.get('lookup')
+        if lookup:
+            table = read_fixed_source(sources[lookup['source']])
+            pairs = table.loc[table[lookup['key']] != '', [lookup['key'], lookup['value']]].drop_duplicates()
+            if pairs[lookup['key']].duplicated().any():
+                raise ValueError('显示连接键不唯一；禁止猜测或插值')
+            values = values.map(pairs.set_index(lookup['key'])[lookup['value']])
+    return pd.to_datetime(values, errors='coerce') if time else pd.to_numeric(values, errors='coerce')
+
+
+def fixed_view_layers(spec: dict, node_id: str, scope: str):
+    """返回实际渲染/导出共用的图层列，空层仍具名保留。"""
+    view = next(v for v in spec['views'] if v['node_id'] == node_id)
+    sources = {s['id']: s for s in spec['sources']}
+    for layer in view['layers']:
+        if scope not in layer.get('scopes', ['known', 'retrospective']):
+            continue
+        frame = select_fixed_rows(spec, view, layer, scope)
+        # 先保留全部原字段，新增列全部使用保留前缀。
+        for field in ('x', 'x0', 'x1'):
+            if field in layer:
+                frame['_aidata_plot_' + field] = _bound(frame, layer[field], sources, time=True)
+        for field in ('y', 'y0', 'y1', 'open', 'high', 'low', 'close'):
+            if field in layer:
+                frame['_aidata_plot_' + field] = _bound(frame, layer[field], sources)
+        frame['_aidata_view_id'] = node_id
+        frame['_aidata_asof'] = view['asof']
+        frame['_aidata_visibility'] = scope
+        yield view, layer, frame
+
+
+def render_fixed_view(run_or_dir, node_id: str):
+    """通过 aidata 的实际 Bokeh consumer 绘制固定图；每品种独立报价轴。"""
+    from bokeh.layouts import column
+    from bokeh.models import (
+        ColumnDataSource, CustomJS, DataTable, Div, HoverTool, Range1d, Select, Span, TableColumn, Tabs,
+    )
+    try:
+        from bokeh.models import TabPanel as Panel
+    except ImportError:
+        from bokeh.models import Panel
+    from bokeh.plotting import figure
+
+    run_dir = Path(getattr(run_or_dir, 'run_dir', run_or_dir))
+    spec = load_fixed_spec(run_dir)
+    view = next(v for v in spec['views'] if v['node_id'] == node_id)
+    panels = []
+    column_cache = {}
+    for scope, title in (('known', '当时已知／原结果快照'), ('retrospective', '事后完整上下文（含未来，禁止当作当时已知）')):
+        right = min(pd.Timestamp(view['end']), pd.Timestamp(view['asof'])) if scope == 'known' else pd.Timestamp(view['end'])
+        xr = Range1d(pd.Timestamp(view['start']), right)
+        figures = {}
+        for symbol in view['symbols']:
+            fig = figure(x_axis_type='datetime', x_range=xr, width=1450, height=330,
+                         title=f'{symbol} — 原始报价单位 — {title}', tools='pan,wheel_zoom,box_zoom,reset,save')
+            fig.name = f'fixed-price/{node_id}/{scope}/{symbol}'
+            fig.yaxis.axis_label = f'{symbol} 原报价（未归一化）'
+            fig.xaxis.axis_label = '原 bar_ts / 原事件自然时间；未重解释交易日历'
+            fig.tags = ['aidata_fixed_price', {'node_id': node_id, 'symbol': symbol, 'scope': scope, 'price_transform': 'identity'}]
+            fig.add_layout(Span(location=pd.Timestamp(view['asof']).value / 1e6,
+                                dimension='height', line_color='black', line_dash='dashed'))
+            figures[symbol] = fig
+        table_sources, table_columns, table_options, table_notes = {}, {}, [], {}
+        for _, layer, frame in fixed_view_layers(spec, node_id, scope):
+            # Bokeh wire 协议不能把 Python list 中的 NaN 当普通 JSON float。
+            # 绘图列以数值/时间 ndarray 传输，保留缺失位，不填0或插值。
+            data = {str(c): (frame[c].to_numpy() if str(c).startswith('_aidata_plot_') else frame[c].tolist())
+                    for c in frame.columns}
+            cds = ColumnDataSource(data, name=f"fixed/{node_id}/{scope}/{layer['id']}")
+            cds.tags = ['aidata_fixed_input', {
+                'view_id': node_id, 'layer_id': layer['id'], 'scope': scope,
+                'kind': layer['kind'], 'source': layer['source'],
+                'known_at': layer.get('known_at', ''), 'rows': len(frame),
+                'symbol': layer.get('symbol', ''),
+                'display_transform': 'raw_columns_preserved; numeric/time_cast; explicit_exact_lookup_only',
+            }]
+            kind = layer['kind']
+            symbol = layer.get('symbol')
+            label = layer.get('label', layer['id'])
+            color = layer.get('color', '#4c78a8')
+            if kind != 'table':
+                fig = figures[symbol]
+                common = dict(source=cds, legend_label=label, tags=['aidata_fixed_glyph', layer['id'], scope])
+                if kind == 'ohlc':
+                    fig.segment('_aidata_plot_x', '_aidata_plot_low', '_aidata_plot_x', '_aidata_plot_high', color=color, **common)
+                    fig.vbar('_aidata_plot_x', width=20 * 60 * 1000, top='_aidata_plot_open', bottom='_aidata_plot_close',
+                             fill_alpha=0.3, line_color=color, fill_color=color, **common)
+                    fig.line('_aidata_plot_x', '_aidata_plot_close', color=color, **common)
+                elif kind == 'line':
+                    fig.line('_aidata_plot_x', '_aidata_plot_y', line_color=color, line_width=1.5, **common)
+                elif kind == 'point':
+                    fig.scatter('_aidata_plot_x', '_aidata_plot_y', marker=layer.get('marker', 'circle'), size=9, color=color, **common)
+                elif kind == 'segment':
+                    fig.segment('_aidata_plot_x0', '_aidata_plot_y0', '_aidata_plot_x1', '_aidata_plot_y1', color=color,
+                                line_width=3, line_dash=layer.get('line_dash', 'solid'), **common)
+                else:
+                    raise ValueError(f'不支持的固定图层: {kind}')
+                tooltip_fields = [c for c in frame.columns if not c.startswith('_aidata_')][:18]
+                fig.add_tools(HoverTool(tooltips=[('物理行', '@_aidata_source_row')] + [(c, '@{' + c + '}') for c in tooltip_fields]))
+            # 同一 CDS 同时供真实图形和原字段表使用，不从另一个范围再造“对应数据”。
+            columns = []
+            for field in (str(c) for c in frame.columns if '_aidata_plot_' not in str(c)):
+                if field not in column_cache:
+                    column_cache[field] = TableColumn(field=field, title=field)
+                columns.append(column_cache[field])
+            table_sources[layer['id']] = cds
+            table_columns[layer['id']] = columns
+            table_options.append((layer['id'], f'{label} [{len(frame)}]'))
+            table_notes[layer['id']] = escape(layer.get('note', '原字段保留；原件内事后时间字段不自动成为当时可知事实。'))
+        for fig in figures.values():
+            if fig.legend:
+                fig.legend.click_policy = 'hide'
+                fig.legend.label_text_font_size = '8pt'
+        notes = '<br>'.join(escape(str(x)) for x in view.get('notes', []))
+        default_layer = view.get('default_table') or next((l['id'] for l in view['layers'] if l['kind'] == 'table'), table_options[0][0])
+        table = DataTable(source=table_sources[default_layer], columns=table_columns[default_layer], width=1450, height=300, index_position=None)
+        layer_selector = Select(title='图层原字段（与图形共用真实数据源）', options=table_options, value=default_layer, width=1100)
+        layer_selector.tags = ['aidata_fixed_layer_selector', {'scope': scope}]
+        table_note = Div(text=table_notes[default_layer])
+        layer_selector.js_on_change('value', CustomJS(
+            args={'table': table, 'sources': table_sources, 'columns': table_columns, 'note': table_note, 'notes': table_notes},
+            code='table.source = sources[cb_obj.value]; table.columns = columns[cb_obj.value]; note.text = notes[cb_obj.value]; table.change.emit();',
+        ))
+        body = column(Div(text=f'<h3>{escape(view["label"])}｜As-Of {escape(view["asof"])}</h3><p>{notes}</p>', width=1450),
+                      *figures.values(), layer_selector, table_note, table)
+        panels.append(Panel(child=body, title=title))
+    navigation = []
+    pages_path = run_dir / 'review/fixed_chart_pages.csv'
+    if pages_path.exists():
+        pages = pd.read_csv(pages_path, dtype=str, keep_default_na=False)
+        links = dict(zip(pages['node_id'], pages['report_url']))
+        selector = Select(title='全部固定窗口入口（保留每项身份）', value=node_id,
+                          options=[(v['node_id'], v['label']) for v in spec['views'] if v['node_id'] in links], width=1000)
+        selector.js_on_change('value', CustomJS(args={'links': links}, code='window.location.href = links[cb_obj.value];'))
+        navigation.append(selector)
+    output = column(Div(text=f'<b>run: {escape(run_dir.name)} / node: {escape(node_id)}</b>'), *navigation, Tabs(tabs=panels))
+    output.name = f'fixed-view/{node_id}'
+    output.tags = ['aidata_fixed_view', {'node_id': node_id, 'asof': view['asof'], 'symbols': view['symbols'],
+                                       'start': view['start'], 'end': view['end'], 'feature_executions': 0}]
+    return output
+
+
+def build_fixed_chart_pages(run):
+    """复用既有 CAE 图节点平台；新消费者仍由 aidata 管理。"""
+    from .big_world_chart import AidataBigWorldReviewCAE, _ensure_platform_runtime, _refresh_created_node_params
+    _ensure_platform_runtime()
+    from mquant.quant.models.graph import CaeNodeDao
+
+    spec = load_fixed_spec(run)
+    rows = []
+    for view in spec['views']:
+        graph = AidataBigWorldReviewCAE({
+            'run_dir': str(run.run_dir), 'run_id': run.run_id,
+            'big_node_id': view['node_id'], 'fixed_input_manifest': 'manifest/fixed_input.json',
+        })
+        created = CaeNodeDao.createUniqueWithFao(tar=graph)
+        _refresh_created_node_params(CaeNodeDao, created, graph)
+        rows.append({'node_id': view['node_id'], 'big_node_id': view['node_id'], 'start_ts': view['start'],
+                     'end_ts': view['end'], 'asof': view['asof'], 'report_url': created['report_url']})
+    out = pd.DataFrame(rows)
+    write_csv(out, run.run_dir / 'review/fixed_chart_pages.csv')
+    return out
