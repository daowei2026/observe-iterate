@@ -0,0 +1,62 @@
+"""固定原件边界：身份、未来隔离、原价及真实 CDS 导出。"""
+import hashlib
+import json
+
+import pandas as pd
+import pytest
+from bokeh.models import ColumnDataSource
+from bokeh.document import Document
+from bokeh.core.json_encoder import serialize_json
+
+from mquant.aidata.fixed_input import build_fixed_chart_run, fixed_view_layers, render_fixed_view
+from mquant.aidata.plot_view_export import export_plot_view_data
+
+
+def fixture_spec(tmp_path):
+    path = tmp_path / 'source.csv'
+    path.write_text('ts,open,high,low,close,known,state\n2021-05-06 09:30:00,100,110,90,105,2021-05-06 10:00:00,Working\n2021-05-07 09:30:00,,,,,2021-05-07 10:00:00,WITHHELD\n')
+    source = {'id': 'frozen', 'path': str(path), 'sha256': hashlib.sha256(path.read_bytes()).hexdigest()}
+    layer = {'id': 'price', 'source': 'frozen', 'symbol': 'rb', 'kind': 'ohlc', 'x': 'ts',
+             'open': 'open', 'high': 'high', 'low': 'low', 'close': 'close',
+             'known_at': 'known', 'window_field': 'ts'}
+    view = {'node_id': 'v1', 'label': '固定原件', 'start': '2021-05-06 09:00:00',
+            'end': '2021-05-08 15:00:00', 'asof': '2021-05-06 10:00:00', 'symbols': ['rb'], 'layers': [layer]}
+    return {'schema_version': 1, 'sources': [source], 'views': [view]}
+
+
+def test_identity_and_future_information_are_not_silently_replaced(tmp_path):
+    spec = fixture_spec(tmp_path)
+    known = list(fixed_view_layers(spec, 'v1', 'known'))[0][2]
+    future = list(fixed_view_layers(spec, 'v1', 'retrospective'))[0][2]
+    assert known['_aidata_source_row'].tolist() == [2]
+    assert future['_aidata_source_row'].tolist() == [2, 3]
+    assert future['close'].tolist() == ['105', '']
+    assert pd.isna(future['_aidata_plot_close'].iloc[1])
+    spec['sources'][0]['sha256'] = '0' * 64
+    with pytest.raises(ValueError, match='身份改变'):
+        list(fixed_view_layers(spec, 'v1', 'known'))
+
+
+def test_raw_quote_and_actual_rendered_source_are_exported_together(tmp_path):
+    spec = fixture_spec(tmp_path)
+    run = build_fixed_chart_run({'run_id': 'test_fixed', 'output_root': str(tmp_path / 'runs'), 'fixed_input': spec})
+    layout = render_fixed_view(run, 'v1')
+    doc = Document()
+    doc.add_root(layout)
+    # 包含空OHLC的事后视图也必须通过真实Bokeh JSON传输，不只构造Python对象。
+    json.loads(serialize_json(doc.to_json()))
+    sources = [s for s in layout.references() if isinstance(s, ColumnDataSource)]
+    assert len(sources) == 2
+    known = next(s for s in sources if '/known/' in s.name)
+    assert known.data['close'] == ['105']
+    assert known.data['_aidata_plot_close'] == [105]
+    manifest = export_plot_view_data(run, 'v1', plot_roots=layout)
+    assert len(manifest['exports']) == 2
+    assert sorted(x['rows'] for x in manifest['exports']) == [1, 2]
+    assert manifest['not_primary_evidence']
+    exported = next(x for x in manifest['exports'] if '/known/' in x['plot_node_path'])
+    csv = pd.read_csv(run.run_dir / 'plot_view_data/v1' / exported['file'], dtype=str, keep_default_na=False)
+    assert csv['close'].tolist() == ['105']
+    assert json.loads((run.run_dir / 'manifest/run_summary.json').read_text())['feature_executions'] == 0
+    with pytest.raises(FileExistsError):
+        build_fixed_chart_run({'run_id': 'test_fixed', 'output_root': str(tmp_path / 'runs'), 'fixed_input': spec})
