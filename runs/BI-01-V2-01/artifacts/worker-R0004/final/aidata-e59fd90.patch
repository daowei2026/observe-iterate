diff --git a/docs/FIXED_INPUT.md b/docs/FIXED_INPUT.md
index bec7322..da6d532 100644
--- a/docs/FIXED_INPUT.md
+++ b/docs/FIXED_INPUT.md
@@ -18,7 +18,7 @@ rendered = render_review_nodes(run, node_ids=['window_001'], export_plot_view_da
 - `sources` 每项为 `id/path/sha256`，可加 ZIP 内 `member`。SHA 是实际 CSV 成员的 SHA-256。路径必须由运行端可信调用方提供；不作为未经鉴权的 Web 文件读取接口。每次读取验证成员身份，原字段按字符串保存；新增 `_aidata_source_row` 是包括表头的一基物理行。
 - `views` 每项为 `node_id/label/start/end/asof/symbols/layers`，可加 `notes`。窗口与 As-Of 必须由调用方声明，不运行默认尺度搜索；图中三品种等成员的 X 轴共享，同一品种的 Y 轴保持原报价单位。
 - `layers` 每项声明 `id/source/kind`，可用 `rows` 指定物理行、用 `filters` 指定 `eq/in/not_empty` 谓词。`window_field` 限制显示上下文，`known_at` 是调用方声明的原可知时钟；known 视图只选择该字段不晚于 As-Of 的原行，空时钟不会补成已知。
-- 图层 `kind` 支持 `ohlc/line/point/segment/table`。图形须声明 `symbol`，通过 `x/y`、`x0/y0/x1/y1` 或 `x/open/high/low/close` 绑定原字段。X 为原自然时间。UTI 显示连接可声明 `{'field': 'actual_uti', 'lookup': {'source': 'kline', 'key': 'closeUti', 'value': 'bar_ts'}}`；仅作精确连接，不猜测、不插值。
+- 图层 `kind` 支持 `ohlc/line/point/segment/table`。图形须声明 `symbol`，通过 `x/y`、`x0/y0/x1/y1` 或 `x/open/high/low/close` 绑定原字段。X 为原自然时间。UTI 显示连接可声明 `{'field': 'actual_uti', 'lookup': {'source': 'kline', 'key': 'closeUti', 'value': 'bar_ts', 'key_type': 'integer'}}`；显式整数键将`75045599.0`与`75045599`作精确数值连接，不取整有小数部分的键，不插值；默认`string`保持原字面连接。原字段始终保留，缺失键不补0。
 - `scopes` 可限制为 `known` 或 `retrospective`，默认均展示。后者独立在“事后完整上下文”标签页，不作为当时已知。包含未来完成时间的原行可保存在原字段表中；调用方必须提供正确 `known_at` 和层说明，不能由工具补业务可知边界。
 
 本模式不计算指标、不改变业务状态、不解释源单位、不填充空 OHLC。原数值和状态与真实 Bokeh ColumnDataSource 一起导出到每个节点独立的 `plot_view_data/render_<node_id>/`。新增绘图列统一使用 `_aidata_plot_` 前缀，只含数值/时间转换和显式精确连接。共享视图继续标记 `not_primary_evidence`；源成员身份及物理行可用于回查原件。
diff --git a/fixed_input.py b/fixed_input.py
index 9f9879a..0a3522c 100644
--- a/fixed_input.py
+++ b/fixed_input.py
@@ -11,6 +11,7 @@ import json
 import re
 import zipfile
 from functools import lru_cache
+from decimal import Decimal, InvalidOperation
 from html import escape
 from pathlib import Path
 from typing import Any
@@ -138,6 +139,37 @@ def select_fixed_rows(spec: dict, view: dict, layer: dict, scope: str) -> pd.Dat
     return frame.copy()
 
 
+def _integer_lookup_key(value):
+    if value is None or str(value).strip() == '':
+        return None
+    try:
+        number = Decimal(str(value))
+    except InvalidOperation as exc:
+        raise ValueError(f'整数显示连接键不是数值: {value!r}') from exc
+    if not number.is_finite():
+        return None
+    if number != number.to_integral_value():
+        raise ValueError(f'整数显示连接键有小数部分，禁止取整: {value!r}')
+    return int(number)
+
+
+@lru_cache(maxsize=96)
+def _lookup_series(encoded_source: str, encoded_lookup: str, mtime_ns: int, size: int):
+    source, lookup = json.loads(encoded_source), json.loads(encoded_lookup)
+    table = _read_source_cached(encoded_source, mtime_ns, size)
+    keys = table[lookup['key']]
+    mode = lookup.get('key_type', 'string')
+    if mode == 'integer':
+        keys = pd.Series([_integer_lookup_key(v) for v in keys], index=keys.index, dtype=object)
+    elif mode != 'string':
+        raise ValueError(f'不支持的显示连接键类型: {mode}')
+    pairs = pd.DataFrame({'key': keys, 'value': table[lookup['value']]})
+    pairs = pairs[pairs['key'].notna() & (pairs['key'] != '')].drop_duplicates()
+    if pairs['key'].duplicated().any():
+        raise ValueError('显示连接键不唯一；禁止猜测或插值')
+    return pairs.set_index('key')['value']
+
+
 def _bound(frame: pd.DataFrame, binding, sources: dict, *, time: bool = False):
     if isinstance(binding, str):
         values = frame[binding]
@@ -145,11 +177,12 @@ def _bound(frame: pd.DataFrame, binding, sources: dict, *, time: bool = False):
         values = frame[binding['field']]
         lookup = binding.get('lookup')
         if lookup:
-            table = read_fixed_source(sources[lookup['source']])
-            pairs = table.loc[table[lookup['key']] != '', [lookup['key'], lookup['value']]].drop_duplicates()
-            if pairs[lookup['key']].duplicated().any():
-                raise ValueError('显示连接键不唯一；禁止猜测或插值')
-            values = values.map(pairs.set_index(lookup['key'])[lookup['value']])
+            source = sources[lookup['source']]
+            stat = Path(source['path']).stat()
+            mapping = _lookup_series(json.dumps(source, sort_keys=True), json.dumps(lookup, sort_keys=True), stat.st_mtime_ns, stat.st_size)
+            if lookup.get('key_type') == 'integer':
+                values = pd.Series([_integer_lookup_key(v) for v in values], index=values.index, dtype=object)
+            values = values.map(mapping)
     return pd.to_datetime(values, errors='coerce') if time else pd.to_numeric(values, errors='coerce')
 
 
