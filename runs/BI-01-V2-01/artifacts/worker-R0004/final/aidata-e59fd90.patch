+def test_explicit_integer_lookup_preserves_raw_float_lexeme_and_maps_real_time(tmp_path):
+    spec = fixture_spec(tmp_path)
+    market = tmp_path / 'market.csv'
+    market.write_text('uti,bar_ts,price\n75045599,2021-05-06 09:30:00,105\n')
+    points = tmp_path / 'points.csv'
+    points.write_text('actual_uti,value\n75045599.0,105\n')
+    for name, path in (('market', market), ('points', points)):
+        spec['sources'].append({'id': name, 'path': str(path), 'sha256': hashlib.sha256(path.read_bytes()).hexdigest()})
+    layer = {'id': 'point', 'source': 'points', 'kind': 'point', 'symbol': 'rb',
+             'x': {'field': 'actual_uti', 'lookup': {'source': 'market', 'key': 'uti', 'value': 'bar_ts', 'key_type': 'integer'}},
+             'y': 'value'}
+    spec['views'][0]['layers'] = [layer]
+    frame = list(fixed_view_layers(spec, 'v1', 'known'))[0][2]
+    assert frame['actual_uti'].tolist() == ['75045599.0']
+    assert frame['_aidata_plot_x'].tolist() == [pd.Timestamp('2021-05-06 09:30:00')]
+    assert frame['_aidata_plot_y'].tolist() == [105]
+    points.write_text('actual_uti,value\n75045599.5,105\n')
+    spec['sources'][-1]['sha256'] = hashlib.sha256(points.read_bytes()).hexdigest()
+    with pytest.raises(ValueError, match='禁止取整'):
+        list(fixed_view_layers(spec, 'v1', 'known'))
