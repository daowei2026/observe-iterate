+def _review_window_bounds(child: pd.Series, *, context: Any = None, calendar_name: str = "") -> tuple[float, float]:
+    """保留既有数值边界；日期用正式切片的同一半开窗口转换入口。
+
+    plotctx_uti_window 返回 [start, stop)，Box 的右边界恢复为原 end 的
+    日历坐标 stop-1。这里既不追加自然日，也不用首末有效行情替代边界。
+    """
+    left = _number_or_none(child.get("start_uti"))
+    right = _number_or_none(child.get("end_uti"))
+    if left is None or right is None:
+        if left is not None or right is not None:
+            raise ValueError(f"Mixed numeric/date review scope: {child.get('node_id', '')}")
+        from .feature_slicer import plotctx_uti_window
+
+        try:
+            window = plotctx_uti_window(child.get("start_uti"), child.get("end_uti"),
+                                        {"context": context, "calendar_name": calendar_name})
+        except Exception as error:
+            raise ValueError(f"Cannot resolve review scope: {child.get('node_id', '')}") from error
+        if window is None:
+            raise ValueError(f"Review scope requires Context/calendar: {child.get('node_id', '')}")
+        left, right = float(window[0]), float(window[1] - 1)
+    if not math.isfinite(left) or not math.isfinite(right) or left > right:
+        raise ValueError(f"Invalid review scope bounds: {child.get('node_id', '')}")
+    return left, right
+
+
 def _main_review_figures(target: Any) -> list[Any]:
