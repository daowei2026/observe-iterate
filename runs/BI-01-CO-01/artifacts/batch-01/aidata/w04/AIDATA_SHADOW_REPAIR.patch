@@ -0,0 +1,95 @@
+"""概览范围坐标和既有原生组合正常恢复的定向回归。"""
+from types import SimpleNamespace
+from pathlib import Path
+import json
+
+import numpy as np
+import pandas as pd
+import pytest
+from bokeh.layouts import column
+from bokeh.models import BoxAnnotation, Label, Toggle
+from bokeh.plotting import figure
+
+from mquant.aidata import big_world_chart as chart
+
+
+def calendar_context():
+    times = np.array(["2021-01-29T21:00:00.500", "2021-02-01T09:00:00.500",
+                      "2021-02-02T09:00:00.500", "2021-04-06T23:00:00",
+                      "2021-04-07T09:00:00.500"], dtype="datetime64[ns]")
+    return SimpleNamespace(sof=SimpleNamespace(tsa_of=lambda name: {"natural_tsa": times}))
+
+
+def test_date_bounds_use_same_calendar_and_keep_end_boundary():
+    # timesearch 的第二端在非交易时间取前一索引，故仍为4月6日23:00。
+    row = pd.Series({"node_id": "big_1", "start_uti": "2021-02-01", "end_uti": "2021-04-07"})
+    assert chart._review_window_bounds(row, context=calendar_context(), calendar_name="fixture") == (1.0, 3.0)
+
+
+@pytest.mark.parametrize("left,right,expected", [(10, 20, (10.0, 20.0)), (10.5, 10.5, (10.5, 10.5))])
+def test_existing_numeric_bounds_preserve_fractional_and_point_windows(left, right, expected):
+    assert chart._review_window_bounds(pd.Series({"start_uti": left, "end_uti": right})) == expected
+
+
+@pytest.mark.parametrize("left,right", [("2021-02-01", "2021-04-07"), ("bad-date", "2021-04-07"), (12, "2021-04-07"), (20, 10)])
+def test_bad_or_unresolvable_ranges_are_explicit(left, right):
+    with pytest.raises(ValueError):
+        chart._review_window_bounds(pd.Series({"node_id": "bad", "start_uti": left, "end_uti": right}))
+
+
+def test_annotations_use_case_label_and_leave_market_glyphs(monkeypatch, tmp_path):
+    fig = figure(title="全局概览 fixture")
+    glyph = fig.line([1, 2], [3, 4])
+    monkeypatch.setattr(chart, "_node_anchor_utis", lambda *args: [])
+    models = []
+    chart._mark_review_scope(fig, node_row=pd.Series({}),
+                             child_rows=pd.DataFrame([{"node_id": "big_1", "scope_label": "C01 / big_1", "start_uti": "2021-02-01", "end_uti": "2021-04-07"}]),
+                             run_dir=tmp_path, child_color="#F28E2B", anchor_color="red", models=models,
+                             context=calendar_context(), calendar_name="fixture")
+    box = next(m for m in models if isinstance(m, BoxAnnotation))
+    assert (box.left, box.right) == (1.0, 3.0)
+    assert next(m for m in models if isinstance(m, Label)).text == "C01 / big_1"
+    assert fig.renderers == [glyph]
+    assert isinstance(chart._review_scope_toggle(models), Toggle)
+
+
+def test_combined_normal_layout_marks_only_overview_and_restores_toggle(monkeypatch, tmp_path):
+    import mquant.uplot
+
+    figures = [figure(title="全局概览 fixture")] + [figure(title=f"C0{n} 30m mid") for n in range(1, 5)]
+    layout = column(*figures)
+    monkeypatch.setattr(mquant.uplot, "CAEGraph", lambda config: SimpleNamespace(layout=lambda: layout))
+    monkeypatch.setattr(chart, "_ensure_plot_runtime", lambda: None)
+    monkeypatch.setattr(chart, "_overview_node_row", lambda cae: pd.Series({}))
+    monkeypatch.setattr(chart, "_node_anchor_utis", lambda *args: [])
+    monkeypatch.setattr(chart, "_read_timespans", lambda *args: pytest.fail("explicit frozen snapshot should restore without re-extraction"))
+    scopes = [{"level": "big", "node_id": f"big_{n}", "scope_label": f"C0{n} / big_{n}",
+               "start_uti": n * 10, "end_uti": n * 10 + 5} for n in range(1, 5)]
+    p = SimpleNamespace(run_dir=str(tmp_path), context=None, calendar_name="fixture",
+                        combined_graph_config={"native": "config"}, overview_scope_rows_json=json.dumps(scopes))
+    cae = SimpleNamespace(P=p)
+    assert chart.AidataRunOverviewCAE.doShowCAEGraph(cae) is cae
+    restored = chart.AidataRunOverviewCAE.layout(cae)
+    assert isinstance(restored.children[0], Toggle)
+    assert restored.children[1] is layout
+    assert len([m for m in figures[0].center if isinstance(m, BoxAnnotation)]) == 4
+    assert all(not [m for m in fig.center if isinstance(m, BoxAnnotation)] for fig in figures[1:])
+
+
+def test_default_overview_retains_search_and_big_scope_paths(monkeypatch, tmp_path):
+    import mquant.uplot
+
+    fig = figure(title="全局概览 fixture")
+    monkeypatch.setattr(mquant.uplot, "CAEGraph", lambda key: SimpleNamespace(layout=lambda: fig))
+    for name in ["_ensure_plot_runtime", "_register_plotters", "_register_run_overview_graph"]:
+        monkeypatch.setattr(chart, name, lambda *args: None)
+    monkeypatch.setattr(chart, "_graph_key", lambda *args: "fixture")
+    monkeypatch.setattr(chart, "_overview_node_row", lambda cae: pd.Series({}))
+    monkeypatch.setattr(chart, "_node_anchor_utis", lambda *args: [])
+    row = {"level": "big", "node_id": "big", "start_uti": 1, "end_uti": 5}
+    monkeypatch.setattr(chart, "_read_timespans", lambda *args: pd.DataFrame([row]))
+    monkeypatch.setattr(chart, "_overview_search_rows", lambda *args: pd.DataFrame([{**row, "node_id": "search"}]))
+    p = SimpleNamespace(run_dir=str(tmp_path), context=None, calendar_name="fixture", overview_start="a", overview_end="b")
+    restored = chart.AidataRunOverviewCAE.layout(SimpleNamespace(P=p))
+    assert isinstance(restored.children[0], Toggle)
+    assert len([m for m in fig.center if isinstance(m, BoxAnnotation)]) == 2
