{
  "schema_version": 1,
  "qualification": "display projection only; formal N remains the referenced TIS product",
  "configuration": {
    "feature": "U2NormalNodeBehaviorFrp",
    "version": "0.2.0",
    "symbol": "rb",
    "mode": "evolution",
    "layout_class": "PerSymFigSet",
    "theme_class": "DefaultFigTheme",
    "shared_x": "bound Calendar UTI",
    "independent_y_by_panel": true,
    "panels": {
      "price": {
        "class": "MainFig",
        "title": "行情与过程边界",
        "unit": "price",
        "height": 420,
        "default": true,
        "price_normalization": false
      },
      "completed_efficiency": {
        "class": "SubFig",
        "title": "已完成过程效率：最近六段／此前六段",
        "unit": "ratio",
        "height": 210,
        "default": true,
        "price_normalization": false
      },
      "working_motion": {
        "class": "SubFig",
        "title": "当前未完成过程：沿原方向净推进／累计最大逆向量",
        "unit": "price",
        "height": 210,
        "default": true,
        "price_normalization": false,
        "include_zero": true
      },
      "working_efficiency": {
        "class": "SubFig",
        "title": "当前过程前缀效率（非已完成样本）",
        "unit": "ratio",
        "height": 180,
        "default": true,
        "price_normalization": false
      },
      "duration": {
        "class": "SubFig",
        "title": "已完成过程时长／当前过程年龄",
        "unit": "CalendarUTITick",
        "height": 200,
        "default": false,
        "price_normalization": false
      },
      "rhythm": {
        "class": "SubFig",
        "title": "局部等待／近期三个极值间隔中位数",
        "unit": "ratio",
        "height": 180,
        "default": false,
        "price_normalization": false,
        "clip_to_probability": false
      }
    },
    "layers": [
      {
        "view_id": "close_path",
        "df_key": "n_display/close_path",
        "time_binding": {
          "time_mode": "uti_point",
          "uti_fields": [
            "x"
          ]
        },
        "slice_levels": [
          "big",
          "mid",
          "small"
        ],
        "plot_binding": {
          "kind": "line",
          "x_field": "x",
          "y_field": "y",
          "group": "price",
          "label": "rb｜原5m close路径",
          "surfaces": [
            "overview",
            "big",
            "mid",
            "small"
          ],
          "style": {
            "line_width": 1,
            "line_dash": "solid",
            "color": "#4C78A8"
          },
          "hover_fields": [
            {
              "field": "symbol",
              "label": "品种"
            },
            {
              "field": "source_exact",
              "label": "正式来源exact"
            },
            {
              "field": "as_of_uti",
              "label": "本视图知识截止UTI"
            },
            {
              "field": "origin_uti",
              "label": "该发生知识UTI"
            },
            {
              "field": "state_text",
              "label": "状态／原因"
            },
            {
              "field": "meaning",
              "label": "对象、范围和单位"
