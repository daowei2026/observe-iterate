{
  "schema_version": 1,
  "qualification": "display projection only; formal N remains the referenced TIS product",
  "configuration": {
    "feature": "U2NormalNodeBehaviorFrp",
    "version": "0.2.2-worker05",
    "symbol": "rb",
    "mode": "selected_cut",
    "layout_class": "PerSymFigSet",
    "theme_class": "DefaultFigTheme",
    "shared_x": "price uses Calendar UTI; scalar viewports are independent single-K summaries",
    "independent_y_by_panel": true,
    "panels": {
      "price": {
        "class": "MainFig",
        "title": "行情与过程边界",
        "unit": "price",
        "height": 420,
        "default": true,
        "price_normalization": false
      },
      "completed_efficiency": {
        "class": "SubFig",
        "title": "已完成过程效率：最近六段／此前六段",
        "unit": "ratio",
        "height": 220,
        "default": true,
        "price_normalization": false
      },
      "working_motion": {
        "class": "SubFig",
        "title": "当前未完成过程：沿原方向净推进／累计最大逆向量",
        "unit": "price",
        "height": 220,
        "default": true,
        "price_normalization": false,
        "include_zero": true
      },
      "working_efficiency": {
        "class": "SubFig",
        "title": "当前过程前缀效率（非已完成样本）",
        "unit": "ratio",
        "height": 220,
        "default": true,
        "price_normalization": false
      },
      "rhythm": {
        "class": "SubFig",
        "title": "局部等待／近期三个极值间隔中位数",
        "unit": "ratio",
        "height": 220,
        "default": false,
        "price_normalization": false,
        "clip_to_probability": false
      },
      "waiting_time": {
        "class": "SubFig",
        "title": "局部等待与正式近期三间隔中位数（非概率）",
        "unit": "CalendarUTITick",
        "height": 220,
        "default": false,
        "price_normalization": false,
        "include_zero": true
      }
    },
    "readability_policy": {
      "price_range": "cover all twelve eligible members and working through K",
      "scalar_layout": {
        "arrangement": "compact_grid",
        "columns": 2,
        "height": 150
      },
      "scalar_x": "keep actual x=K; detach historical shared x range; show only K tick and a single-cut label",
      "scalar_x_padding": "equal display-only margins, at least 24 screen pixels; no synthetic or future records",
      "numeric_range_function": "numeric_display_range",
      "fit_y_range": "explicit nondegenerate y range; check final range after callbacks",
      "legend": {
        "placement": "outside_above",
        "short_labels": true
      },
      "value_labels": "each present scalar has a readable value+unit in the margin; no hover required",
      "absent_value": "explicit state/reason rather than an unexplained blank or zero",
      "price_tick_labels": {
        "mode": "adaptive",
        "maximum_visible": 10,
        "fixed_5m_labels": false
      },
      "temporal_note": "member actual endpoints and confirmation times differ; scalar has one observation only",
      "rhythm_detail": "waiting / actual recent interval median = waiting_ratio, never a probability cap"
    },
    "display_identity_fields": [
      "symbol",
      "node_life",
      "data_binding",
      "mode",
      "selected_k_or_requested_range",
      "resolved_exact_or_occurrence_selection",
      "configuration_version",
      "optional_panels"
    ],
    "layers": [
      {
