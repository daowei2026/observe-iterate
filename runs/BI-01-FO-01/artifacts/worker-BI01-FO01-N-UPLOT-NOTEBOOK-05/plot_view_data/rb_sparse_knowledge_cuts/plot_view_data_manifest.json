{
  "schema_version": 1,
  "qualification": "display projection only; formal N remains the referenced TIS product",
  "configuration": {
    "feature": "U2NormalNodeBehaviorFrp",
    "version": "0.2.2-worker05",
    "symbol": "rb",
    "mode": "evolution",
    "layout_class": "PerSymFigSet",
    "theme_class": "DefaultFigTheme",
    "shared_x": "bound Calendar UTI",
    "independent_y_by_panel": true,
    "panels": {
      "price": {
        "class": "MainFig",
        "title": "行情与过程边界",
        "unit": "price",
        "height": 420,
        "default": true,
        "price_normalization": false
      },
      "completed_efficiency": {
        "class": "SubFig",
        "title": "已完成过程效率：最近六段／此前六段",
        "unit": "ratio",
        "height": 210,
        "default": true,
        "price_normalization": false
      },
      "working_motion": {
        "class": "SubFig",
        "title": "当前未完成过程：沿原方向净推进／累计最大逆向量",
        "unit": "price",
        "height": 210,
        "default": true,
        "price_normalization": false,
        "include_zero": true
      },
      "working_efficiency": {
        "class": "SubFig",
        "title": "当前过程前缀效率（非已完成样本）",
        "unit": "ratio",
        "height": 180,
        "default": true,
        "price_normalization": false
      },
      "rhythm": {
        "class": "SubFig",
        "title": "局部等待／近期三个极值间隔中位数",
        "unit": "ratio",
        "height": 180,
        "default": false,
        "price_normalization": false,
        "clip_to_probability": false
      },
      "waiting_time": {
        "class": "SubFig",
        "title": "局部等待与正式近期三间隔中位数（非概率）",
        "unit": "CalendarUTITick",
        "height": 200,
        "default": false,
        "price_normalization": false,
        "include_zero": true
      }
    },
    "readability_policy": {
      "primary_range": "intersection of selected actual occurrence coverage and price coverage",
      "range_function": "evolution_display_range",
      "price_context": "separate price-only overview on demand; not the scalar-panel range",
      "tick_labels": {
        "mode": "adaptive",
        "maximum_visible": 10,
        "fixed_5m_labels": false
      },
      "legend": {
        "placement": "outside_above",
        "short_labels": true
      },
      "numeric_range_function": "numeric_display_range",
      "fit_y_range": "use explicit bounded range; do not allow a later callback to collapse it",
      "value_labels": "selected/last observed values in margins; no plot-wide labels per bar",
      "state_changes": "mark actual working-Life/start/direction changes at known K; not trading signals",
      "storage_changes": "retain in hover; never label every working address as a new market process",
      "rhythm_detail": "show actual waiting, current interval median, local-start and last-update when selected",
      "empty_region": "outside formal coverage is not zero, immature, or a market gap"
    },
    "display_identity_fields": [
      "symbol",
      "node_life",
      "data_binding",
      "mode",
      "selected_k_or_requested_range",
      "resolved_exact_or_occurrence_selection",
      "configuration_version",
      "optional_panels"
    ],
    "layers": [
      {
        "view_id": "close_reference_points",
