test-suite frp-tests
  -- 类型：exitcode-stdio-1.0 是测试套件的标准类型，表示通过 exit code 判断成功或失败
  type:               exitcode-stdio-1.0

  -- 测试的入口文件。需要在 test 目录下创建这个文件。
  main-is:            Spec.hs

  -- 指定测试代码所在的源目录
  hs-source-dirs:     test

  -- Cabal 通常会自动发现测试目录下的模块。如果它找不到，可以在这里手动添加。
  -- 比如：
  other-modules:
    Frp.Instance.Testing.Gen
    Frp.Instance.Apt.ReflexSpec
    Frp.Instance.ISL.Eaw.InterfaceSpec
    Frp.Instance.ISL.Eaw.P2BoundedStateSpec
    Frp.Instance.ISL.Eaw.P2V211Spec

  -- GHC 编译选项，建议与您的 library 节保持一致，并为测试添加线程支持
  ghc-options:        -Wall -fno-warn-orphans -funbox-strict-fields -fspecialise-aggressively -O2 -ddump-splices -threaded -rtsopts -with-rtsopts=-N

  -- 默认语言，与 library 节保持一致
  default-language:   GHC2021

  -- 默认 GHC 扩展，建议从 library 节复制过来，以确保环境一致
  default-extensions: 
    OverloadedStrings 
    OverloadedLists
    OverloadedLabels 
    DuplicateRecordFields
    RecordWildCards
    LambdaCase 
    BangPatterns 
    ViewPatterns
    TupleSections 
    MultiWayIf 
    TemplateHaskell 
    RecursiveDo
    TypeFamilies
    DeriveAnyClass

  build-depends:
      -- 1. 基础依赖包
      base

      -- 2. 核心！依赖项目自身的 'frp' 库。
      --    这个名字必须与文件顶部的 'name' 字段完全一致。
      --    这样您的测试代码才能 import "src" 目录下的模块。
    , frp

      -- 3. 添加测试框架的依赖，这里以 Hspec 为例
    , hspec
    , uuid

      -- 4. 从 library 节复制所有其他相关的依赖包。
      --    测试代码很可能需要用到和主代码相同的库。
    , template-haskell
    , derive-storable 
    , containers
    , data-default
    , dependent-map 
    , dependent-sum 
    , lens
    , mtl
    , ref-tf
    , time 
    , transformers
    , witherable
