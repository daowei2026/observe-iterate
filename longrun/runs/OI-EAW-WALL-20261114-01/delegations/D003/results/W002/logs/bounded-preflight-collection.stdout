description:
    Please see the README on Github at <https://github.com/e-wrks/edh/lossless-decimal>
category: Numeric,Arithmetic
build-type: Simple
extra-source-files:
    README.md
    CHANGELOG.md

source-repository head
    type: git
    location: https://github.com/e-wrks/edh
    subdir: lossless-decimal

library
    exposed-modules:
        Data.Lossless.Decimal
    hs-source-dirs: src
    default-language:   Haskell2010
    default-extensions:
        NoImplicitPrelude
        BangPatterns
        ConstraintKinds
        DataKinds
        FlexibleContexts
        FlexibleInstances
        GADTs
        KindSignatures
        LambdaCase
        OverloadedStrings
        ScopedTypeVariables
        TupleSections
        TypeApplications
        AllowAmbiguousTypes
        TypeOperators
        ViewPatterns
    ghc-options: -Wall
    build-depends:
        base >=4.12 && <5
        , hashable -any
