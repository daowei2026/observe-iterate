-        'value2.xConfirm': dbav2['confirm2D']['x'],
-        'value2.yConfirm': dbav2['confirm2D']['y'],
-    }, index=self.value2.ts)
+    df1 = _scaleTurnValueADT2DF(self.value1, 'value1')
