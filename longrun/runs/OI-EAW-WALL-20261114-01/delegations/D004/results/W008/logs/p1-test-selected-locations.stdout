630:  (sameBuildState, duplicateBuildPublications) <- requireRight "Build exact duplicate" (applyBuildFrame buildState [buildStart])
682:  (absorbState, absorbPublications) <- requireRight "complete Absorb transition table" (applyAbsorbFrame (emptyAbsorbInteractionState wallCatalog) absorbLifecycle)
686:  (twoWallAbsorbState, _) <- requireRight "Absorb start with two valid Walls" (applyAbsorbFrame (emptyAbsorbInteractionState twoWallCatalog) [absorbStart])
688:  (sameAbsorbState, duplicateAbsorbPublications) <- requireRight "Absorb exact duplicate" (applyAbsorbFrame absorbState [absorbStart])
