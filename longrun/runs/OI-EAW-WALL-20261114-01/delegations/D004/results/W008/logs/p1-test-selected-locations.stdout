584:  (_, absorbs) <- requireRight "Absorb with exact Wall catalog" (applyAbsorbFrame (emptyAbsorbInteractionState wallCatalog) [absorbStart])
586:  _ <- requireRight "Attack with exact Wall catalog" (applyAttackFrame (emptyAttackSegmentBookState wallCatalog) [] [formation] [])
