503:wallLifecycleTransitionTableMustBeComplete :: IO ()
504:wallLifecycleTransitionTableMustBeComplete = do
520:      ended = wallChange "wall-occurrence-5" 14 (Spine.WallEnded (Spine.WallEndReason "producer-end"))
527:  (endedState, publications) <- requireRight "complete Wall transition table" (applyWallOccurrenceBatch emptyWallLifecycleState lifecycle)
531:  (presentState, _) <- requireRight "Wall present state" (applyWallOccurrenceBatch emptyWallLifecycleState [wallStart])
534:  (dormantState, _) <- requireRight "Wall dormant state" (applyWallOccurrenceBatch presentState [becameDormant])
