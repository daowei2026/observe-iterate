1019:requireRight :: (Show error) => String -> Either error value -> IO value
1020:requireRight label = either (fail . ((label <> ": ") <>) . show) pure
1026:requireBsonRoundTrip :: (Eq value, ToBSON value, FromBSON value) => String -> value -> IO ()
