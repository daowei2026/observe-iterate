{
  "worker_return": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "run_id",
      "work_order_id",
      "order_ref",
      "worker",
      "return_to",
      "outcome",
      "result_ref",
      "missing",
      "manifest"
    ],
    "properties": {
      "schema": {
        "const": "longrun-worker-return/v2"
      },
      "run_id": {
        "$ref": "#/$defs/id"
      },
      "work_order_id": {
        "type": "string",
        "pattern": "^W[0-9]{3,}$"
      },
      "order_ref": {
        "$ref": "#/$defs/ref"
      },
      "worker": {
        "type": "string",
        "minLength": 1
      },
      "return_to": {
        "type": "string",
        "minLength": 1
      },
      "outcome": {
        "enum": [
          "EXECUTED",
          "PARTIAL",
          "STOP",
          "FAILED"
        ]
      },
      "result_ref": {
        "$ref": "#/$defs/ref"
      },
      "missing": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "manifest": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "sha256"
          ],
          "properties": {
            "ref": {
              "$ref": "#/$defs/ref"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  }
}
