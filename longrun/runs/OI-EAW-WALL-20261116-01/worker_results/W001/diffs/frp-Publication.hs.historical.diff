 -- current_view 是按业务身份追加的最新状态更新表，不是每次更新都复制截至
 -- 当时的全局快照。完整 current Map 仍由各 DSU 的 Dynamic 提供给 FRP 消费者。
 
+decodeStorageList :: String -> (stored -> Either Text.Text value) -> [stored] -> [value]
+decodeStorageList field decode = fmap requireDecoded
+  where
+    requireDecoded stored =
+      case decode stored of
+        Right value -> value
+        Left reason ->
+          error
+            ( "invalid P1 physical storage in "
+                <> field
+                <> ": "
+                <> Text.unpack reason
+            )
+
+decodeStorageValue :: String -> (stored -> Either Text.Text value) -> stored -> value
+decodeStorageValue field decode stored =
+  case decode stored of
+    Right value -> value
+    Left reason ->
+      error
+        ( "invalid P1 physical storage in "
+            <> field
+            <> ": "
+            <> Text.unpack reason
+        )
+
+applyCurrentUpdates :: (Ord key) => (view -> key) -> [view] -> Map key view -> Map key view
+applyCurrentUpdates keyOf updates current =
+  foldl' (\views view -> Map.insert (keyOf view) view views) current updates
+
+data WallLoadedPart
+  = WallLoadedOccurrences [WallLifecycleOccurrence]
+  | WallLoadedCurrent [P1WallCurrentStorage]
+
+data BuildLoadedPart
+  = BuildLoadedOccurrences [BuildActivityOccurrence]
+  | BuildLoadedCurrent [P1BuildCurrentStorage]
+
+data AbsorbLoadedPart
+  = AbsorbLoadedOccurrences [AbsorbInteractionOccurrence]
+  | AbsorbLoadedCurrent [P1AbsorbCurrentStorage]
+
+decodeWallCurrentParts :: FeatureRunIdentity -> [WallLoadedPart] -> [WallCurrentView]
+decodeWallCurrentParts runIdentity parts =
+  case (concat [values | WallLoadedOccurrences values <- parts], concat [values | WallLoadedCurrent values <- parts]) of
+    ([], []) -> []
+    ([], _) -> error "invalid P1 physical storage: wall_current_view has no same-UTI wall_occurrences"
+    (_, []) -> error "invalid P1 physical storage: wall_occurrences has no same-UTI wall_current_view"
+    (occurrences, storedCurrent) ->
+      let occurrenceByIdentity =
+            foldl'
+              (\values occurrence -> Map.insert (wallOccurrenceIdentity occurrence) occurrence values)
+              Map.empty
+              occurrences
+       in decodeStorageList
+            "wall_current_view"
+            (wallCurrentFromStorage runIdentity occurrenceByIdentity)
+            storedCurrent
+
+decodeBuildCurrentParts :: FeatureRunIdentity -> FeatureRunIdentity -> [BuildLoadedPart] -> [BuildCurrentView]
+decodeBuildCurrentParts buildRun wallRun parts =
+  case (concat [values | BuildLoadedOccurrences values <- parts], concat [values | BuildLoadedCurrent values <- parts]) of
+    ([], []) -> []
+    ([], _) -> error "invalid P1 physical storage: build_current_view has no same-UTI build_occurrences"
+    (_, []) -> error "invalid P1 physical storage: build_occurrences has no same-UTI build_current_view"
+    (occurrences, storedCurrent) ->
+      let occurrenceByIdentity =
+            foldl'
+              (\values occurrence -> Map.insert (buildOccurrenceIdentity occurrence) occurrence values)
+              Map.empty
+              occurrences
+       in decodeStorageList
+            "build_current_view"
+            (buildCurrentFromStorage buildRun wallRun occurrenceByIdentity)
+            storedCurrent
+
+decodeAbsorbCurrentParts :: FeatureRunIdentity -> FeatureRunIdentity -> [AbsorbLoadedPart] -> [AbsorbCurrentView]
+decodeAbsorbCurrentParts absorbRun wallRun parts =
+  case (concat [values | AbsorbLoadedOccurrences values <- parts], concat [values | AbsorbLoadedCurrent values <- parts]) of
+    ([], []) -> []
+    ([], _) -> error "invalid P1 physical storage: absorb_current_view has no same-UTI absorb_occurrences"
+    (_, []) -> error "invalid P1 physical storage: absorb_occurrences has no same-UTI absorb_current_view"
+    (occurrences, storedCurrent) ->
+      let occurrenceByIdentity =
+            foldl'
+              (\values occurrence -> Map.insert (absorbOccurrenceIdentity occurrence) occurrence values)
+              Map.empty
+              occurrences
+       in decodeStorageList
+            "absorb_current_view"
+            (absorbCurrentFromStorage absorbRun wallRun occurrenceByIdentity)
+            storedCurrent
+
+loadWallOutputs :: (Fao owner, HasHisBack) => owner -> FeatureRunIdentity -> FaoModel (Maybe WallLifecycleOutputs)
+loadWallOutputs owner runIdentity = withEventLoad owner $ do
+  occurrences <- fmap (decodeStorageList "wall_occurrences" (wallOccurrenceFromStorage runIdentity) . mul) <$> loadAdtEvent' @(MulWrap P1WallOccurrenceStorage) "wall_occurrences"
+  storedCurrent <- fmap mul <$> loadAdtEvent' @(MulWrap P1WallCurrentStorage) "wall_current_view"
+  let currentUpdates =
+        decodeWallCurrentParts runIdentity
+          <$> mergeWith
+            (<>)
+            [ (\values -> [WallLoadedOccurrences values]) <$> occurrences,
+              (\values -> [WallLoadedCurrent values]) <$> storedCurrent
+            ]
+  diagnostics <- fmap (decodeStorageValue "wall_diagnostics" (wallDiagnosticsFromStorage runIdentity) . mul) <$> loadAdtEvent' @(MulWrap P1DiagnosticStorage) "wall_diagnostics"
+  current <- foldDyn (applyCurrentUpdates wallCurrentIdentity) Map.empty currentUpdates
+  pure
+    WallLifecycleOutputs
+      { wallLifecycleOccurrences = occurrences,
+        wallLifecycleCurrent = current,
+        wallLifecycleCurrentUpdates = currentUpdates,
+        wallLifecycleDiagnostics = diagnostics
+      }
+
+loadBuildOutputs :: (Fao owner, HasHisBack) => owner -> FeatureRunIdentity -> FeatureRunIdentity -> FaoModel (Maybe BuildActivityOutputs)
+loadBuildOutputs owner buildRun wallRun = withEventLoad owner $ do
+  occurrences <- fmap (decodeStorageList "build_occurrences" (buildOccurrenceFromStorage buildRun wallRun) . mul) <$> loadAdtEvent' @(MulWrap P1BuildOccurrenceStorage) "build_occurrences"
+  storedCurrent <- fmap mul <$> loadAdtEvent' @(MulWrap P1BuildCurrentStorage) "build_current_view"
+  let currentUpdates =
+        decodeBuildCurrentParts buildRun wallRun
+          <$> mergeWith
+            (<>)
+            [ (\values -> [BuildLoadedOccurrences values]) <$> occurrences,
+              (\values -> [BuildLoadedCurrent values]) <$> storedCurrent
+            ]
+  diagnostics <- fmap (decodeStorageValue "build_diagnostics" (buildDiagnosticsFromStorage buildRun wallRun) . mul) <$> loadAdtEvent' @(MulWrap P1DiagnosticStorage) "build_diagnostics"
+  current <- foldDyn (applyCurrentUpdates buildCurrentIdentity) Map.empty currentUpdates
+  pure
+    BuildActivityOutputs
+      { buildActivityOccurrences = occurrences,
+        buildActivityCurrent = current,
+        buildActivityCurrentUpdates = currentUpdates,
+        buildActivityDiagnostics = diagnostics
+      }
+
+loadAttackOutputs :: (Fao owner, HasHisBack) => owner -> FeatureRunIdentity -> FeatureRunIdentity -> FeatureRunIdentity -> FeatureRunIdentity -> AttackFormationMethodSnapshot -> FaoModel (Maybe AttackSegmentBookOutputs)
+loadAttackOutputs owner attackRun formationRun barrierRun wallRun methodSnapshot = withEventLoad owner $ do
+  segments <- fmap (decodeStorageList "attack_segments" (attackSegmentFromStorage attackRun wallRun methodSnapshot) . mul) <$> loadAdtEvent' @(MulWrap P1AttackSegmentStorage) "attack_segments"
+  formations <- fmap (decodeStorageList "formation_evidence" (formationEvidenceFromStorage formationRun wallRun) . mul) <$> loadAdtEvent' @(MulWrap P1FormationEvidenceStorage) "formation_evidence"
+  barriers <- fmap (decodeStorageList "wall_attack_barriers" (wallBarrierFromStorage barrierRun wallRun) . mul) <$> loadAdtEvent' @(MulWrap P1WallBarrierStorage) "wall_attack_barriers"
+  currentSegments <- fmap (decodeStorageList "attack_segment_book_current_view" (attackSegmentFromStorage attackRun wallRun methodSnapshot) . mul) <$> loadAdtEvent' @(MulWrap P1AttackSegmentStorage) "attack_segment_book_current_view"
+  diagnostics <- fmap (decodeStorageValue "attack_diagnostics" (attackDiagnosticsFromStorage attackRun wallRun) . mul) <$> loadAdtEvent' @(MulWrap P1DiagnosticStorage) "attack_diagnostics"
+  let currentChanges =
+        mergeWith
+          (<>)
+          [ fmap recordFormedAttackSegment <$> currentSegments,
+            fmap appendAttackFormationEvidence <$> formations,
+            fmap appendWallAttackBarrier <$> barriers
+          ]
+  current <-
+    foldDyn
+      (\changes state -> foldl' (flip ($)) state changes)
+      emptyAttackSegmentBookCurrentView
+      currentChanges
+  pure
+    AttackSegmentBookOutputs
+      { attackSegmentsAtWall = segments,
+        attackFormationMaterials = formations,
+        wallAttackBarriers = barriers,
+        attackSegmentBookCurrent = current,
+        attackSegmentBookDiagnostics = diagnostics
+      }
+
+loadAbsorbOutputs :: (Fao owner, HasHisBack) => owner -> FeatureRunIdentity -> FeatureRunIdentity -> FaoModel (Maybe AbsorbInteractionOutputs)
+loadAbsorbOutputs owner absorbRun wallRun = withEventLoad owner $ do
+  occurrences <- fmap (decodeStorageList "absorb_occurrences" (absorbOccurrenceFromStorage absorbRun wallRun) . mul) <$> loadAdtEvent' @(MulWrap P1AbsorbOccurrenceStorage) "absorb_occurrences"
+  storedCurrent <- fmap mul <$> loadAdtEvent' @(MulWrap P1AbsorbCurrentStorage) "absorb_current_view"
+  let currentUpdates =
+        decodeAbsorbCurrentParts absorbRun wallRun
+          <$> mergeWith
+            (<>)
+            [ (\values -> [AbsorbLoadedOccurrences values]) <$> occurrences,
+              (\values -> [AbsorbLoadedCurrent values]) <$> storedCurrent
+            ]
+  diagnostics <- fmap (decodeStorageValue "absorb_diagnostics" (absorbDiagnosticsFromStorage absorbRun wallRun) . mul) <$> loadAdtEvent' @(MulWrap P1DiagnosticStorage) "absorb_diagnostics"
+  current <- foldDyn (applyCurrentUpdates absorbCurrentIdentity) Map.empty currentUpdates
+  pure
+    AbsorbInteractionOutputs
+      { absorbInteractionOccurrences = occurrences,
+        absorbInteractionCurrent = current,
+        absorbInteractionCurrentUpdates = currentUpdates,
+        absorbInteractionDiagnostics = diagnostics
+      }
+
