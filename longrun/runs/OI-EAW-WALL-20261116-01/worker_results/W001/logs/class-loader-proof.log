from typing import *
from ....core import *
from ..base import AbsFao

__all__ = ["AbstractFileDao", "AbstractFaoDao"]


class AbstractFileDao(LoggingMixIn):
    """数据存取对象接口"""

    def is_exist_data(self) -> bool:
        # 是否保存了数据
        raise NotImplementedError

    def __init__(self, feat: AbsFao):
        self.feat = feat
        self._init_attrs()

    def _init_attrs(self):
        pass

    def __getattr__(self, key):
        """没有的属性，则使用目标对象的属性"""
        return getattr(self.feat, key)

    def load(self, refresh=True):
        """加载结果"""
        pass

    def dump(self, *args, **kwargs):
        """保存结果"""
        pass

    @property
    def full_dir(self):
        return self.feat.full_dir

    @property
    def freq(self):
        return self.feat.freq

    @property
    def file_name(self):
        return self.feat.file_name or self.freq


class AbstractFaoDao(AbstractFileDao):

    def _init_attrs(self):
        self.__tar_fields = {}

    @property
    def freq(self):
        return self.feat.freq or "@"

    @property
    def tar_fields(self) -> dict:
        # 同一特征不同目标对象字段可能不同
        key = self.feat.tar_name
        res = self.__tar_fields.get(key, None)
        if res is None:
            res = self.load_fields()
            self.__tar_fields[key] = res
        return res

    def load_fields(self):
        # 加载字段信息
        raise NotImplementedError

    def is_exist_data(self) -> bool:
        # 是否保存了数据
        raise NotImplementedError

    def load(self, refresh=False):
        """读取数据"""
        raise NotImplementedError

    def dump(self, *args, **kwargs):
        """保存结果"""
        raise NotImplementedError
