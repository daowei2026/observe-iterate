class StraApp:
    """
    StraEnv 其他扩展
    1、获取以及检查所有特征类等
    2、清楚类实例以及运行时环境等缓存
    """

    class_cache: Dict[str, "FaoCacheMeta"] = {}

    @classmethod
    def clear_cache(cls):
        # 清除特征类实例缓存
        for each in cls.class_cache.values():
            each.clear_instance()
        # 清除运行时缓存
        FaoResultManager.clear_cache()

    @classmethod
    def push_class(cls, v):
        """保存特征类"""
        cls.class_cache[v.__name__] = v

    @classmethod
    def load_class(cls):
        """加载所有特征类"""
        return cls.class_cache

    @classmethod
    def get_class(cls, name: str, reget=True):
        c = cls.class_cache.get(name, None)
        if c is None and reget:
            name = name.split("@")[0]  # ATR@"Test" 有可能为该格式
            c = cls.class_cache.get(name, None)
            if c is None and reget:
                # 可能是函数特征，在不改变原有基础上，再查询一次
                name = FuncUtil.hump(name)
                c = cls.get_class(name, reget=False)
        return c

    @classmethod
    def check_class(cls, name):
        if settings.MQUANT_ON_CHECK:
            return cls.get_class(name, reget=False)
        return None


class KwMeta(type):
    """初始化类关键字列表"""

    KEY_WORDS = set()  # set

    def __new__(cls, name, bases, attrs):
        res = type.__new__(cls, name, bases, attrs)
        res.KEY_WORDS = res.KEY_WORDS.union(dir(res))
        return res
    

class FaoCacheMeta(KwMeta):
    """缓存实例Meta"""

    instance_cache = None
    cls_doc = object

    def __new__(cls, name, bases, attrs):
        res = super().__new__(cls, name, bases, attrs)
        res.instance_cache = GeneralCache()
        StraApp.push_class(res)
        return res
