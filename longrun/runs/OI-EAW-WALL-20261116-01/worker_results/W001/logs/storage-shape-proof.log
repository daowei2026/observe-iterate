-- | WallLifecycleChange 与 Measurement WallBand 均按显式 tag 展开。
-- tag 决定哪些值有效；未使用的基础字段只占物理占位，不产生业务默认值。
-- FeatureRunIdentity、artifact、WallRef 和 symbol 均由同一产品输入的薄 receipt
-- 唯一决定，不在每条 occurrence 中重复数百字节的运行级文本。
data P1WallOccurrenceStorage = P1WallOccurrenceStorage
  { p1WallOccurrenceLocalNo :: Int64,
    p1WallOccurrenceRef :: Text,
    p1WallLifecycleSide :: Text,
    p1WallLifecycleOccurredAt :: Int,
    p1WallLifecycleChangeKind :: Text,
    p1WallBandMeasurementKind :: Text,
    p1WallBandMeasurementReason :: Text,
    p1WallBandLow :: Double,
    p1WallBandHigh :: Double,
    p1WallCore :: Double,
    p1WallPresence :: Text,
    p1WallEndReason :: Text,
    p1WallLifecycleAvailability :: Text
  }
  deriving (Eq, Show, Generic, ToBSON, FromBSON)

data P1WallCurrentStorage = P1WallCurrentStorage
  { p1WallCurrentLocalNo :: Int64,
    p1WallCurrentState :: Text
  }
  deriving (Eq, Show, Generic, ToBSON, FromBSON)

data P1DoubleMeasurementStorage = P1DoubleMeasurementStorage
  { p1DoubleMeasurementKind :: Text,
    p1DoubleMeasurementValue :: Double,
    p1DoubleMeasurementReason :: Text
  }
