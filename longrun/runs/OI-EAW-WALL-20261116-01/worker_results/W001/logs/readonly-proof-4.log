    @classmethod
    def read_field_ts(cls, full_dir,field:str=None,is_event:bool=False,key:str = None):
        """ 读取字段时间轴 
        key 不为None，表示两层，如 Datarame 型特征
        """
        tsPath = None
        if is_event:
            tsPath = f"{key}.{field}.{TS_PATH_NAME}" if key else f"{field}.{TS_PATH_NAME}"
        else:
            tsPath = f"{key}.{TS_PATH_NAME}" if key else TS_PATH_NAME
        return DbaUtil.read_ndarray(full_dir, tsPath, "M8[ns]")

