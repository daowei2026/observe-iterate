def _split_same_time_rows(rows, base_key):
    """不改业务时间；仅在 result-key 维度分开同拍物理 occurrence。"""
    if rows.index.is_unique:
        return {base_key: require_dba_frame(base_key, rows.copy())}
    # 现有平台 DBA 整数字段只支持 int8/int64；这里是物理分流序号，
    # 直接使用 int64，避免同拍多 occurrence 首次出现时才在 dump 阶段失败。
    ordinals = rows.groupby(level=0, sort=False).cumcount().astype("int64")
    streams = {}
    for ordinal in sorted(set(int(value) for value in ordinals.values)):
        selected = rows.loc[ordinals == ordinal].copy()
        selected["occurrence_ordinal"] = np.int64(ordinal)
        key = base_key if ordinal == 0 else f"{base_key}__occ{ordinal:04d}"
        streams[key] = require_dba_frame(key, selected)
    return streams


def object_keyed_streams(frame, *, prefix, local_no_column):
    """按 run-local number 切业务对象流；同拍多 occurrence 不改写时间。"""
    if local_no_column not in frame.columns:
        if frame.shape[0] == 0:
            return {}
        raise P1ReceiptError(f"{prefix} 缺 local number: {local_no_column}")
    streams = {}
    for local_no, rows in frame.groupby(local_no_column, sort=False):
        local_no = int(local_no)
        if local_no < 0:
            raise P1ReceiptError(f"{prefix} local number 不得为负")
        for key, value in _split_same_time_rows(
            rows, f"{prefix}__{local_no}"
        ).items():
            if key in streams:
                raise P1ReceiptError(f"重复 DBA result key: {key}")
            streams[key] = value
    return streams

