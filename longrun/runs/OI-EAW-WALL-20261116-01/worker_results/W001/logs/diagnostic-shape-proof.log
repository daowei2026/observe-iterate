-- | 四个产品共用的物理诊断行。业务错误仍由各 DSU 的具名 sum type 定义；
-- 这里只把 constructor 和参数拆成 DBA 可保存的基础字段。诊断数量本来就应
-- 很少，因此不牺牲信息来追求列数最少。
data P1DiagnosticStorage = P1DiagnosticStorage
  { p1DiagnosticSource :: Text,
    p1DiagnosticKind :: Text,
    p1DiagnosticText1 :: Text,
    p1DiagnosticText2 :: Text,
    p1DiagnosticText3 :: Text,
    p1DiagnosticDouble1 :: Double,
    p1DiagnosticInt1 :: Int64,
    p1DiagnosticInt2 :: Int64,
    p1DiagnosticInt3 :: Int64
  }
  deriving (Eq, Show, Generic, ToBSON, FromBSON)

wallOccurrenceToStorage :: WallLifecycleOccurrence -> P1WallOccurrenceStorage
diagnosticsFromStorage stateFromStorage rows = do
  let ingressRows = filter ((== "ingress") . p1DiagnosticSource) rows
      stateRows = filter ((== "state") . p1DiagnosticSource) rows
      unknownSources = filter (\row -> p1DiagnosticSource row /= "ingress" && p1DiagnosticSource row /= "state") rows
  case unknownSources of
    row : _ -> Left ("unknown P1 diagnostic source: " <> p1DiagnosticSource row)
    [] ->
      P1ProductDiagnostics
        <$> traverse ingressErrorFromStorage ingressRows
        <*> traverse stateFromStorage stateRows

ingressErrorToStorage :: P1IngressError -> P1DiagnosticStorage
ingressErrorToStorage value = case value of
  MissingNumericField field -> (base "MissingNumericField") {p1DiagnosticText1 = field}
  NonFiniteNumericField field number -> (base "NonFiniteNumericField") {p1DiagnosticText1 = field, p1DiagnosticDouble1 = number}
  NonIntegralNumericField field number -> (base "NonIntegralNumericField") {p1DiagnosticText1 = field, p1DiagnosticDouble1 = number}
  InvalidResultKey key -> (base "InvalidResultKey") {p1DiagnosticText1 = key}
  UnknownNumericCode field code -> (base "UnknownNumericCode") {p1DiagnosticText1 = field, p1DiagnosticInt1 = fromIntegral code}
  InvalidNumericDomain field detail -> (base "InvalidNumericDomain") {p1DiagnosticText1 = field, p1DiagnosticText2 = detail}
  QualifiedUtiCountMismatch expected actual -> (base "QualifiedUtiCountMismatch") {p1DiagnosticInt1 = fromIntegral expected, p1DiagnosticInt2 = fromIntegral actual}
  MissingExactUpstream product -> (base "MissingExactUpstream") {p1DiagnosticText1 = product}
  ExactUpstreamMismatch product -> (base "ExactUpstreamMismatch") {p1DiagnosticText1 = product}
  MissingAttackMethodSnapshot -> base "MissingAttackMethodSnapshot"
  AttackProductReceiptMismatch detail -> (base "AttackProductReceiptMismatch") {p1DiagnosticText1 = detail}
  MissingWallLocalNo localNo -> (base "MissingWallLocalNo") {p1DiagnosticInt1 = localNo}
  ReceiptSourceScopeMismatch detail -> (base "ReceiptSourceScopeMismatch") {p1DiagnosticText1 = detail}
  where
    base = emptyDiagnostic "ingress"

ingressErrorFromStorage :: P1DiagnosticStorage -> Either Text P1IngressError
ingressErrorFromStorage stored = case p1DiagnosticKind stored of
  "MissingNumericField" -> Right (MissingNumericField (p1DiagnosticText1 stored))
  "NonFiniteNumericField" -> Right (NonFiniteNumericField (p1DiagnosticText1 stored) (p1DiagnosticDouble1 stored))
  "NonIntegralNumericField" -> Right (NonIntegralNumericField (p1DiagnosticText1 stored) (p1DiagnosticDouble1 stored))
  "InvalidResultKey" -> Right (InvalidResultKey (p1DiagnosticText1 stored))
  "UnknownNumericCode" -> Right (UnknownNumericCode (p1DiagnosticText1 stored) (fromIntegral (p1DiagnosticInt1 stored)))
  "InvalidNumericDomain" -> Right (InvalidNumericDomain (p1DiagnosticText1 stored) (p1DiagnosticText2 stored))
  "QualifiedUtiCountMismatch" -> Right (QualifiedUtiCountMismatch (fromIntegral (p1DiagnosticInt1 stored)) (fromIntegral (p1DiagnosticInt2 stored)))
  "MissingExactUpstream" -> Right (MissingExactUpstream (p1DiagnosticText1 stored))
  "ExactUpstreamMismatch" -> Right (ExactUpstreamMismatch (p1DiagnosticText1 stored))
  "MissingAttackMethodSnapshot" -> Right MissingAttackMethodSnapshot
  "AttackProductReceiptMismatch" -> Right (AttackProductReceiptMismatch (p1DiagnosticText1 stored))
  "MissingWallLocalNo" -> Right (MissingWallLocalNo (p1DiagnosticInt1 stored))
  "ReceiptSourceScopeMismatch" -> Right (ReceiptSourceScopeMismatch (p1DiagnosticText1 stored))
  kind -> Left ("unknown P1 ingress diagnostic kind: " <> kind)

wallDiagnosticsToStorage :: P1ProductDiagnostics WallLifecycleError -> [P1DiagnosticStorage]
wallDiagnosticsToStorage = diagnosticsToStorage wallErrorToStorage

wallDiagnosticsFromStorage :: FeatureRunIdentity -> [P1DiagnosticStorage] -> Either Text (P1ProductDiagnostics WallLifecycleError)
wallDiagnosticsFromStorage wallRun = diagnosticsFromStorage (wallErrorFromStorage wallRun)

wallErrorToStorage :: WallLifecycleError -> P1DiagnosticStorage
wallErrorToStorage value = case value of
  WallOccurrenceRefConflict (OccurrenceRef ref) -> (base "WallOccurrenceRefConflict") {p1DiagnosticText1 = ref}
  WallStartedTwice identity -> withWall "WallStartedTwice" identity
  WallMustStartPresent identity -> withWall "WallMustStartPresent" identity
  WallUpdateBeforeStart identity -> withWall "WallUpdateBeforeStart" identity
