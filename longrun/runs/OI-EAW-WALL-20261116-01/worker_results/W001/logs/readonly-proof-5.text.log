class dtype:
    __slots__ = ("repr", "dt")

    def __init__(self, repr_: str, dt: Optional[np.dtype] = None):
        self.repr = repr_
        if dt is None:
            self.dt = np.dtype(repr_)
        else:
            self.dt = dt

    def __repr__(self):
        return self.repr


