class CurrTradeSet(AbsContextManager):
    """
    Manager for current iset in context

    """

    __slots__ = "_sof", "_dsl", "_engine", "_arena", "_depth"

    DSL_DEFAULTS = {
        "freq": Freq("1d"),  # sampling freq, main trading freq as well
        "pos_chgr": PosChgr(),  # position changer
        "budgeter": Budgeter(),  # budgeter
    }

    def __init__(self, sof, dsl_override: Optional[dict] = None, trade_engine=None):
        self._sof = sof
        self._dsl = {**self.DSL_DEFAULTS}
        if dsl_override is not None:
            self._dsl.update(dsl_override)
        self._engine = trade_engine
        self._arena = None
        self._depth = 0

    def __enter__(self):
        stack = self.get_stack()
        if self._depth > 0:
            assert self in stack, "depth corrupted ?!"
            assert self._arena is not None, "on stack but no arena ?!"
        else:
            assert self not in stack, "depth corrupted ?!"
            assert self._arena is None, "dirty arena ?!"
            self._arena = {}
            stack.append(self)

        self._depth += 1
        return self._dsl, self._arena

    def _cmexit_before(self, stack, exc_type, exc_val, exc_tb):
        assert self in stack, "stack corrupted ?!"
        self._depth -= 1
        if self._depth > 0:
            assert self._arena is not None, "depth corrupted ?!"
        else:
            assert stack[-1] is self, "stack corrupted ?!"
            self._arena = None

