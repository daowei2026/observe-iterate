        opt_blks = kwargs.get("opt_blks", self.opt_blks)
        full_period = kwargs.get("full_period", self.full_period)
        return Sof(sof_name, stk_tlist, startDay, endDay,opt_blks=opt_blks,full_period=full_period)

    def tsa_of(self, calendar_name):
        dba_path = f"{self.sof_dir}/../calendar/{calendar_name}"
        natural_dba = DbArray(dba_path, "natural_tsa", "M8[ns]")
        linear_dba = DbArray(dba_path, "linear_tsa", "i8")
        return {"natural_tsa": natural_dba.ndarray, "linear_tsa": linear_dba.ndarray}

    
