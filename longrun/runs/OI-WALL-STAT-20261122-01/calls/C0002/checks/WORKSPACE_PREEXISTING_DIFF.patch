+def _exclude_empty_calendar_padding(cc_df, trading_day_ranges, logger=None):
+    """排除分时段首个半秒的全空日历占位，不丢弃任何有效行情。"""
+    index = cc_df.index
+    if len(index) == 0:
+        return cc_df
+    quote_columns = ["price", "buy_price1", "buy_vol1", "sell_price1", "sell_vol1"]
+    half_second = pd.Timedelta(milliseconds=500)
+    segment_start = np.r_[True, np.diff(index.asi8) > half_second.value]
+    candidates = np.flatnonzero(segment_start)
+    empty = cc_df.iloc[candidates][quote_columns].isna().all(axis=1).to_numpy()
+    excluded = []
+    for position in candidates[empty]:
+        if (position + 1 < len(index)
+                and index[position + 1] - index[position] == half_second
+                and cc_df.iloc[position + 1][quote_columns].notna().all()):
+            excluded.append(int(position))
+    covered = np.zeros(len(cc_df), dtype=bool)
+    for duration in trading_day_ranges:
+        start = int(index.searchsorted(pd.Timestamp(duration.start), side="left"))
+        stop = int(index.searchsorted(pd.Timestamp(duration.stop), side="right"))
+        covered[start:stop] = True
+    covered[excluded] = True
+    if not covered.all():
+        raise ValueError("交易日区间外存在有效行情或非半秒开盘占位，拒绝丢弃输入")
+    if not excluded:
+        return cc_df
+    keep = np.ones(len(cc_df), dtype=bool)
+    keep[excluded] = False
+    # 仅复制本 Feature 消费的列；原始 DBA、空占位及其时间轴保持原样。
+    selected = cc_df.loc[keep, quote_columns + ["linear_ts"]].copy()
+    timestamps = [stamp.isoformat() for stamp in index[excluded]]
+    selected.attrs.update(cc_df.attrs)
+    cut = source_scope(CurrSymbol.sym(), cc_df, calendar=CurrCalendar.name(True))["market_source_cut"]
+    selected.attrs["market_source_cut"] = cut + "|excluded-empty-calendar-padding:" + ",".join(timestamps)
+    if logger is not None:
+        logger.warning("Wall 输入排除全空半秒日历占位 %d 行: %s", len(timestamps), timestamps)
+    return selected
+
+
